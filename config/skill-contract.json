{
  "schema_version": 3,
  "skill_version": "0.18.0",
  "name": "reader-seat",
  "primary_routes": [
    {
      "id": "news",
      "reference": "references/scenario-news.md"
    },
    {
      "id": "technical",
      "reference": "references/scenario-technical.md"
    },
    {
      "id": "product",
      "reference": "references/scenario-product.md"
    },
    {
      "id": "business",
      "reference": "references/scenario-business.md"
    },
    {
      "id": "analysis",
      "reference": "references/scenario-analysis.md"
    },
    {
      "id": "procedure",
      "reference": "references/scenario-procedure.md"
    }
  ],
  "shared_modules": [
    "references/runtime-enforcement.md",
    "references/scenario-routing.md",
    "references/output-standards.md",
    "references/signal-processing.md"
  ],
  "conditional_modules": [
    {
      "id": "format-decision",
      "condition": "every finished artifact selects a format and portable presentation baseline",
      "reference": "references/format-decision.md"
    },
    {
      "id": "diagnosis-and-revision",
      "condition": "the task rewrites or diagnoses an existing document",
      "reference": "references/diagnosis-and-revision.md"
    },
    {
      "id": "evaluation",
      "condition": "the user requests comparison or scoring, risk is high, or skill rules are being changed",
      "reference": "references/evaluation.md"
    },
    {
      "id": "visual-decision",
      "condition": "every finished artifact decides whether a material visual reduces reader cost",
      "reference": "references/visual-decision.md"
    },
    {
      "id": "visual-communication",
      "condition": "the visual decision retains or reviews a chart, diagram, table, screenshot, callout, semantic color, card group, or encoded layout",
      "reference": "references/visual-communication.md"
    },
    {
      "id": "visual-evidence",
      "condition": "any visual is selected, generated, replaced, captioned, or published",
      "reference": "references/visual-evidence.md"
    },
    {
      "id": "title-design",
      "condition": "the output needs a title, headline, subtitle, or title diagnosis",
      "reference": "references/title-design.md"
    },
    {
      "id": "html-output",
      "condition": "the task produces or edits a finished artifact; use the HTML default or the portable presentation baseline for an explicit non-HTML format",
      "reference": "references/html-output.md"
    },
    {
      "id": "agent-portability",
      "condition": "the skill is installed, adapted, or regression-tested in another agent host",
      "reference": "references/agent-portability.md"
    }
  ],
  "runtime_loading": {
    "profile": "config/module-profiles.json",
    "resolver": "scripts/resolve_modules.py",
    "policy": "minimum-complete-module-set",
    "capability_reduction_allowed": false,
    "active_scenario_contract_extracted_from_canonical_module": true,
    "format_decision_module": "references/format-decision.md",
    "html_implementation_loaded_only_when_selected": true,
    "visual_decision_module": "references/visual-decision.md",
    "visual_implementation_module": "references/visual-communication.md"
  },
  "runtime_enforcement": {
    "contract_script": "scripts/runtime_contract.py",
    "unit_tests": "tests/test_runtime_contract.py",
    "required_for_every_task": true,
    "decision_lock": [
      "output-language",
      "output-format",
      "publication-target",
      "external-action",
      "publication-authorization"
    ],
    "external_action_guard_required": true,
    "action_preflight_receipt_required": true,
    "semantic_review_required": true,
    "independent_judge_required_for_high_risk": true,
    "verification_receipt_required": true,
    "fail_closed_on_missing_or_failed_receipt": true,
    "host_wrapper_required_for_absolute_enforcement": true
  },
  "cross_agent_evaluation": {
    "adapters": "config/agent-adapters.json",
    "runner": "scripts/run_evals.py",
    "cases": "evals/cross-agent-cases.json",
    "rubric": "evals/judge-rubric.md",
    "judge_schema": "evals/judge-output.schema.json",
    "minimum_repetitions_for_stability_claim": 3,
    "minimum_distinct_agents_for_cross_agent_claim": 2,
    "minimum_automated_judge_repetitions_for_stability_claim": 2,
    "requires_semantic_judge": true,
    "report_worst_run": true
  },
  "retained_capabilities": [
    "six-scenario-routing",
    "create-rewrite-diagnose-compare",
    "source-dominant-language-selection",
